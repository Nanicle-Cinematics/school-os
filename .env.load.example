# The load test's OWN environment. Copy to .env.load (git-ignored) and fill in nothing real.
#
# Everything the load scripts and the server they start read comes from THIS file and not from
# .env: `npm run load:*` passes it with --env-file, and scripts/load/guard.mts refuses to run
# when any URL below is the dev or production database, or when SMS is not a dry run.
#
# A throwaway local Postgres 17 is the default. For a production-shaped run against a hosted
# throwaway (a separate Supabase project, never dev or prod) set LOAD_ALLOW_REMOTE=yes and
# LOAD_CONFIRM_TARGET to that project's ref, and use its URLs here.

# The owner connection: Prisma CLI, the seed, the runner's own queries.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/school_os_load"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/school_os_load"

# What the app connects as. `npm run load:rls` creates this role with APP_DB_PASSWORD, so the
# two must agree. connection_limit=4 is what production uses for the app role.
APP_DATABASE_URL="postgresql://school_os_app:load-app-role-not-a-real-secret@localhost:5432/school_os_load?connection_limit=4"
APP_DB_PASSWORD="load-app-role-not-a-real-secret"
DB_RLS="on"

# A fixed test key, the same one CI uses. Not a secret.
TOTP_ENCRYPTION_KEY="Y2ktdG90cC1rZXktbm90LWEtcmVhbC1zZWNyZXQteHg="

# Never text anyone. A fake school's parents have fake numbers, and a real gateway would still bill.
SMS_PROVIDER=""
SMS_API_KEY=""
SMS_DRY_RUN="1"

# The server `npm run load:serve` starts, and where the runner sends its requests.
APP_URL="http://localhost:3100"
LOAD_BASE_URL="http://localhost:3100"

# Only for a remote throwaway:
# LOAD_ALLOW_REMOTE="yes"
# LOAD_CONFIRM_TARGET="<the throwaway project's ref>"
