{
  "name": "school-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "postinstall": "prisma generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:rls": "node --env-file=.env scripts/apply-rls.mjs",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "make:admin": "node --env-file=.env scripts/make-platform-admin.mjs",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "db:verify": "node --env-file=.env scripts/verify-seed.mjs",
    "verify:results": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env scripts/verify-results.mts",
    "verify:sms": "tsx scripts/verify-sms.mts",
    "verify:audience": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env scripts/verify-audience.mts",
    "verify:isolation": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env scripts/verify-isolation.mts",
    "verify:onboarding": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env scripts/verify-onboarding.mts",
    "verify:teacher": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env scripts/verify-teacher.mts",
    "verify:actions": "node --env-file=.env scripts/verify-actions.mjs",
    "verify:invoicing": "NODE_OPTIONS=--conditions=react-server tsx scripts/verify-invoicing.mts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
