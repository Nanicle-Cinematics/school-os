{
  "name": "school-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "postinstall": "prisma generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:rls": "node --env-file=.env scripts/apply-rls.mjs",
    "audit:rls": "node scripts/audit-rls.mjs",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "platform": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env scripts/platform.mts",
    "platform:prod": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.prod scripts/platform.mts",
    "make:admin": "node --env-file=.env scripts/make-platform-admin.mjs",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "db:verify": "node --env-file=.env scripts/verify-seed.mjs",
    "verify:results": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env scripts/verify-results.mts",
    "verify:sms": "tsx scripts/verify-sms.mts",
    "verify:audience": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env scripts/verify-audience.mts",
    "verify:isolation": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env scripts/verify-isolation.mts",
    "verify:onboarding": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env scripts/verify-onboarding.mts",
    "verify:teacher": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env scripts/verify-teacher.mts",
    "verify:parent": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env scripts/verify-parent.mts",
    "verify:reset": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env scripts/verify-reset.mts",
    "verify:export": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env scripts/verify-export.mts",
    "verify:export:route": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env scripts/verify-export-route.mts",
    "verify:contrast": "tsx scripts/verify-contrast.mts",
    "verify:design": "tsx scripts/verify-design.mts",
    "verify:theme": "tsx scripts/verify-theme.mts",
    "verify:settings": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env scripts/verify-settings.mts",
    "verify:platform": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env scripts/verify-platform.mts",
    "verify:platform:sql": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env scripts/verify-platform-sql.mts",
    "verify:attention": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env scripts/verify-attention.mts",
    "verify:collections": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env scripts/verify-collections.mts",
    "verify:activity": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env scripts/verify-activity.mts",
    "verify:search": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env scripts/verify-search.mts",
    "shots": "node --env-file=.env scripts/screenshot.mjs",
    "shots:portal": "node --env-file=.env scripts/portal-shots.mjs",
    "verify:actions": "node --env-file=.env scripts/verify-actions.mjs",
    "verify:invoicing": "NODE_OPTIONS=--conditions=react-server tsx scripts/verify-invoicing.mts",
    "verify:mobile-nav": "node --env-file=.env scripts/verify-mobile-nav.mjs",
    "verify:finance": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env scripts/verify-finance.mts",
