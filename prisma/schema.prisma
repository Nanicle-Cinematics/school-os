// School OS — multi-tenant school management SaaS
// Market: Ghana / GES (KG–SHS, 3 terms, CA + exam weighting, GHS, mobile money)
//
// Tenancy rule: EVERY tenant-owned table carries `schoolId` and is indexed on it.
// Postgres Row-Level Security is applied to each of them by `npm run db:rls` and
// is ENFORCED, so a table without schoolId is not merely untidy — it is a table
// no policy can protect.
//
// Scope: Phase 1 (foundation + people), Phase 2 (fees + expenditure),
// Phase 3 (assessment), plus SMS. Deliberately NOT modelled yet: timetable,
// attendance, admissions, library, boarding, transport, health, payroll.
// Single-campus by design — no Branch model; add one only if a school asks.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (Supabase :6543, ?pgbouncer=true)
  directUrl = env("DIRECT_URL") // direct (Supabase :5432) — migrations only
}

// ─────────────────────────────────────────────────────────────────────────────
// PLATFORM & TENANCY
// ─────────────────────────────────────────────────────────────────────────────

// Two paid plans, separated by price rather than by roll size — see PLANS in
// src/lib/subscription.ts. The four-tier ladder that was here (STARTER, GROWTH,
// SCHOOL_PLUS) was a placeholder nobody had priced.
enum Plan {
  TRIAL
  INSTITUTION
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  SUSPENDED
}

model School {
  id        String  @id @default(cuid())
  name      String
  slug      String  @unique // subdomain / URL key
  shortName String? // "STAMS" — used on report cards and SMS sender ID
  motto     String?
  logoUrl   String?
  crestUrl  String?

  // Contact & registration
  email           String?
  phone           String?
  altPhone        String?
  website         String?
  address         String?
  town            String?
  district        String?
  region          String? // Ghanaian region
  gpsAddress      String? // GhanaPost GPS digital address
  accreditationNo String? // GES / Ministry registration number
  tin             String? // Ghana Revenue Authority Tax Identification Number, printed on bills

  headName         String?
  headSignatureUrl String?

  // Locale
  currency String @default("GHS")
  timezone String @default("Africa/Accra")

  // Subscription
  plan               Plan               @default(TRIAL)
  subscriptionStatus SubscriptionStatus @default(TRIALING)
  trialEndsAt        DateTime?
  studentCap         Int? // plan-based seat limit; null = unmetered

  /**
   * Paid up to this date. The subscription is monthly, so recording a payment
   * moves it a month on — from the date it already held, not from today, so a
   * school that pays four days late does not quietly lose four days.
   */
  paidUntil  DateTime?
  /**
   * What this school pays a month, in cedis. Null until agreed.
   */
  monthlyFee Decimal?  @db.Decimal(10, 2)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  settings            SchoolSettings?
  assets              SchoolAsset[]
  assessmentTemplates AssessmentTemplate[]
  memberships         Membership[]
  users               User[]
  auditLogs           AuditLog[]
  sequences           NumberSequence[]

  academicYears AcademicYear[]
  terms         Term[]
  levels        Level[]
  classGroups   ClassGroup[]
  subjects      Subject[]
  levelSubjects LevelSubject[]
  programmes    Programme[]
  houses        House[]

  students            Student[]
  guardians           Guardian[]
  studentGuardians    StudentGuardian[]
  staff               Staff[]
  enrollments         Enrollment[]
  teachingAssignments TeachingAssignment[]

  gradingScales  GradingScale[]
  gradeBands     GradeBand[]
  assessments    Assessment[]
  scores         Score[]
  mockExams      MockExam[]
  mockScores     MockScore[]
  subjectResults SubjectResult[]
  termResults    TermResult[]

  feeCategories            FeeCategory[]
  feeStructures            FeeStructure[]
  feeStructureItems        FeeStructureItem[]
  billCodes                BillCode[]
  invoices                 Invoice[]
  invoiceItems             InvoiceItem[]
  discounts                Discount[]
  studentDiscounts         StudentDiscount[]
  payments                 Payment[]
  paymentAllocations       PaymentAllocation[]
  expenseCategories        ExpenseCategory[]
  expenses                 Expense[]
  vendors                  Vendor[]
  vendorBills              VendorBill[]
  vendorPayments           VendorPayment[]
  vendorPaymentAllocations VendorPaymentAllocation[]

  messageTemplates MessageTemplate[]
  campaigns        MessageCampaign[]
  messages         Message[]

  attendanceDays    AttendanceDay[]
  attendanceEntries AttendanceEntry[]
  fileAttachments   FileAttachment[]
  budgets           Budget[]
  paymentPlans      PaymentPlan[]
  planInstalments   PaymentPlanInstalment[]
  statementLines    StatementLine[]
  ledgerAccounts    LedgerAccount[]
  journalEntries    JournalEntry[]
  journalLines      JournalLine[]

  @@index([plan, subscriptionStatus])
}

/// A school's crest, logo or the head's signature, stored as bytes.
///
/// Deliberately its own table rather than columns on School: `getSessionUser`
/// does `include: { school: true }` on EVERY request, and Prisma selects all
/// scalar fields, so a Bytes column there would drag the image into every page
/// load. School keeps only the pointer (`crestUrl`, `headSignatureUrl`), which
/// costs nothing to carry and tells a report card whether to render one at all
/// without a second query.
/// A photographed bank slip or expense receipt.
///
/// Separate from SchoolAsset because that table is keyed @@unique([schoolId,
/// kind]) — one crest per school — and these are one per voucher, unbounded.
/// Same storage decision though: bytes in a row, served by a route, because
/// there is no object store configured and a school's whole term of receipts is
/// a few megabytes.
model FileAttachment {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  mimeType String
  bytes    Bytes
  byteSize Int

  uploadedByUserId String?
  createdAt        DateTime @default(now())

  @@index([schoolId])
}

/// What a school INTENDS to spend on a heading this term, against which the
/// cash book is the actual.
///
/// Per term, not per year: a Ghanaian school's money arrives in the first weeks
/// of each term and is spent within it, so a yearly figure would be compared
/// against a third of a year for two thirds of the time and read as a surplus
/// that is not there.
///
/// One row per (term, category). A heading with no row simply has no budget,
/// which is different from a budget of zero — and the screen says so, because
/// "unbudgeted" and "overspent by everything" are not the same sentence.
model Budget {
  id         String          @id @default(cuid())
  schoolId   String
  school     School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  termId     String
  term       Term            @relation(fields: [termId], references: [id], onDelete: Cascade)
  categoryId String
  category   ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  amount Decimal @db.Decimal(12, 2)
  note   String?

  setByUserId String?
  setBy       User?   @relation("BudgetSetBy", fields: [setByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([termId, categoryId])
  @@index([schoolId])
}

/// An agreed arrangement to pay one bill in tranches.
///
/// Attached to the INVOICE rather than the student: a bill is already per
/// student per term, which is the unit a school actually negotiates over, and
/// an arrangement that outlived the term it was agreed for would quietly excuse
/// arrears nobody discussed.
///
/// ⚠️ A plan does not change what is owed. `Invoice.balance` is untouched and
/// remains the truth; a plan only says WHEN the school agreed it would arrive,
/// which is what stops a parent who is keeping to an arrangement being chased
/// as a debtor and having their child's report card withheld.
model PaymentPlan {
  id        String  @id @default(cuid())
  schoolId  String
  school    School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  invoiceId String  @unique
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  note        String?
  cancelledAt DateTime?

  agreedByUserId String?
  agreedBy       User?   @relation("PlanAgreedBy", fields: [agreedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  instalments PaymentPlanInstalment[]

  @@index([schoolId])
}

/// One tranche of a plan: how much, by when.
///
/// Deliberately carries no paid/unpaid column. Which tranches are covered is
/// derived from the invoice's own amountPaid at read time — a stored flag would
/// be a second opinion about the same money, and this codebase has already
/// learnt what happens when a status rots beside the ledger that moved on.
model PaymentPlanInstalment {
  id       String      @id @default(cuid())
  schoolId String
  school   School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  planId   String
  plan     PaymentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  sequence Int
  dueDate  DateTime
  amount   Decimal  @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@unique([planId, sequence])
  @@index([schoolId])
}

/// A line read off a bank or mobile-money statement during reconciliation.
///
/// Kept rather than matched-and-forgotten, because the useful half of a
/// reconciliation is the lines that did NOT match: money in the account that
/// the book has no record of. Those are the ones a bursar has to explain.
model StatementLine {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  paidAt    DateTime
  amount    Decimal  @db.Decimal(12, 2)
  reference String?
  narration String?

  /// The payment this line was matched to, if any. Null is the finding.
  paymentId String?  @unique
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  importedByUserId String?
  importedAt       DateTime @default(now())

  @@index([schoolId])
  @@index([schoolId, paidAt])
}

model SchoolAsset {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  kind     SchoolAssetKind
  mimeType String
  bytes    Bytes
  byteSize Int

  uploadedByUserId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([schoolId, kind])
  @@index([schoolId])
}

enum SchoolAssetKind {
  CREST
  LOGO
  HEAD_SIGNATURE
}

// Report-card and policy configuration, split out so School stays readable.
model SchoolSettings {
  id       String @id @default(cuid())
  schoolId String @unique
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  // Assessment policy — Ghana convention is 30/70 (SHS) or 50/50 (basic).
  classScoreWeight Int @default(30) // percent
  examScoreWeight  Int @default(70) // percent; must sum to 100

  defaultGradingScaleId String?

  // Report card
  showClassPosition   Boolean @default(true)
  showSubjectPosition Boolean @default(true)
  showAggregate       Boolean @default(true) // BECE-style best-6 aggregate
  aggregateSubjects   Int     @default(6)

  /// The year mark, as a percentage of the marks available across all three
  /// terms, below which a child repeats the class instead of moving up.
  /// GES practice is a 45% pass; a school that marks differently changes it.
  promotionPassPercent Int @default(45)
  // No reportCardTemplate. It offered a second layout that was never built, so
  // the column stored an answer nothing asked for. Removed 2026-09-12.

  // Fees policy
  blockReportOnArrears Boolean @default(false)
  invoiceDueDays       Int     @default(14)

  /// Spending at or above this needs a second signature before it counts as
  /// paid. Null means the school has not asked for approvals, which is the
  /// right default: a one-stream basic school where the proprietor IS the
  /// bursar should not be made to approve its own chalk.
  expenseApprovalThreshold Decimal? @db.Decimal(12, 2)
  // Free text printed on every bill: momo number, bank account, who to pay and
  // where. Deliberately not modelled as fields — schools use momo, a bank, the
  // bursar's window or all three, and the arrangement changes without warning.
  paymentInstructions      String?
  // Printed under the total, e.g. "Fees are payable in full by the third week."
  invoiceNote              String?

  /// The school's own core accounts — where the posting engine (ledger-engine.ts)
  /// looks up which LedgerAccount to debit/credit for a cash movement. All five
  /// are optional: a school that has not finished setting up its chart of
  /// accounts keeps billing, paying and spending exactly as before — see the
  /// "additive, best-effort" rule in ledger-engine.ts.
  ///
  /// Plain ids, not a Prisma relation, matching `defaultGradingScaleId` right
  /// above: this app's convention for a "soft" cross-reference the READING
  /// code resolves itself, not one the database enforces. A declared relation
  /// field here would sit unread by name (code reaches these only as `…Id`)
  /// and become exactly the dead field verify:settings exists to catch —
  /// caught by forcing this guard against a fresh database rather than
  /// assumed, per this repo's own rule for trusting a check.
  cashAccountId       String?
  bankAccountId       String?
  momoAccountId       String?
  receivableAccountId String?
  payableAccountId    String?

  // SMS
  smsProvider           SmsProvider?
  smsSenderId           String?
  smsEnabled            Boolean      @default(false)
  notifyOnPayment       Boolean      @default(true)
  notifyOnResultPublish Boolean      @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Per-school counters for admission numbers, invoice numbers, receipt numbers.
// Incremented inside a transaction so numbers never collide or skip.
model NumberSequence {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  key      String // ADMISSION | INVOICE | RECEIPT | STAFF | VOUCHER
  prefix   String @default("")
  padding  Int    @default(4)
  next     Int    @default(1)

  @@unique([schoolId, key])
  @@index([schoolId])
}

// ─────────────────────────────────────────────────────────────────────────────
// AUTH, ROLES & AUDIT
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  OWNER // proprietor
  HEAD // headmaster / headmistress
  ASSISTANT_HEAD
  ADMIN // secretary / registrar
  ACCOUNTANT // bursar
  TEACHER
  LIBRARIAN
  HOUSE_MASTER
  NURSE
  /// Manages ACCESS, not what access permits. See ACCOUNT_SUPPORT in
  /// permissions.ts: an IT admin unlocks and resets accounts; leadership
  /// decides what those accounts may do.
  IT_ADMIN
  PARENT
}

enum MemberStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

model User {
  id           String  @id @default(cuid())
  email        String? @unique
  phone        String? @unique // many Ghanaian parents sign in by phone, not email
  passwordHash String?
  name         String
  avatarUrl    String?

  isPlatformAdmin Boolean @default(false) // Nanicle super-admin

  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?

  // Set whenever the account is handed a TEMPORARY password — on creation, and
  // on an admin reset. The layouts divert such a session to /account/password
  // and nothing else, so a password the office read aloud cannot stay in use.
  mustChangePassword Boolean   @default(false)
  passwordChangedAt  DateTime?
  /// When the current TEMPORARY password was handed out. Null once the person has
  /// chosen their own. Past 14 days an unused temporary password stops working.
  passwordIssuedAt   DateTime?

  // Second factor for the Nanicle platform admin (authenticator-app codes, RFC 6238).
  // The secret is AES-256-GCM encrypted under TOTP_ENCRYPTION_KEY before it is stored,
  // so a database dump alone does not contain it. `totpEnabledAt` null with a secret
  // present means enrolment was started and never confirmed.
  totpSecretEnc          String?
  totpEnabledAt          DateTime?
  /// Newest 30-second step already accepted; a code for that step or an earlier one
  /// is refused, so a code cannot be replayed.
  totpLastStep           Int?
  /// SHA-256 of each unused one-time recovery code.
  recoveryCodeHashes     String[]  @default([])
  /// SHA-256 of the one-time ENROLMENT code a platform admin must present before they may attach
  /// their first authenticator. Issued by `make:admin`, `platform admin` and `reset-platform-2fa`,
  /// never by the app, and cleared once enrolment completes. See `enrolment-code.ts`.
  enrolmentCodeHash      String?
  enrolmentCodeExpiresAt DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  deletedAt              DateTime?

  // Home school (nullable: platform admins belong to none)
  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  memberships    Membership[]
  sessions       Session[]
  passwordResets PasswordReset[]
  auditLogs      AuditLog[]

  recordedPayments       Payment[]         @relation("PaymentRecordedBy")
  approvedDiscounts      StudentDiscount[] @relation("DiscountApprovedBy")
  createdCampaigns       MessageCampaign[]
  recordedExpenses       Expense[]         @relation("ExpenseRecordedBy")
  approvedExpenses       Expense[]         @relation("ExpenseApprovedBy")
  budgetsSet             Budget[]          @relation("BudgetSetBy")
  plansAgreed            PaymentPlan[]     @relation("PlanAgreedBy")
  recordedVendorBills    VendorBill[]      @relation("VendorBillRecordedBy")
  approvedVendorBills    VendorBill[]      @relation("VendorBillApprovedBy")
  recordedVendorPayments VendorPayment[]   @relation("VendorPaymentRecordedBy")
  postedJournalEntries   JournalEntry[]    @relation("JournalEntryPostedBy")

  @@index([schoolId])
}

// One login can hold several roles in a school (Head who also teaches), and a
// parent with children in two schools gets one membership per school.
model Membership {
  id       String       @id @default(cuid())
  schoolId String
  school   School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId   String
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     Role
  status   MemberStatus @default(ACTIVE)

  // The person record this login represents, when applicable.
  staffId    String?
  staff      Staff?    @relation(fields: [staffId], references: [id], onDelete: SetNull)
  guardianId String?
  guardian   Guardian? @relation(fields: [guardianId], references: [id], onDelete: SetNull)

  invitedAt  DateTime?
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([schoolId, userId, role])
  @@index([schoolId])
  @@index([userId])
}

/**
 * A one-time code that lets a parent who has forgotten their password set a new
 * one, without the office reading a password down a phone line.
 * NO schoolId, deliberately — like Session and User. The whole flow happens
 * BEFORE anyone is signed in, so there is no tenant context to scope it by, and
 * a tenant table read without one is refused outright (see src/lib/prisma.ts).
 * The code itself is never stored: `codeHash` is a SHA-256 of it, the same shape
 * Session uses for its token, so a leaked database row cannot be replayed into
 * an account.
 */
model PasswordReset {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String
  expiresAt  DateTime
  /**
   * Set the moment it is spent, so a code works exactly once.
   */
  consumedAt DateTime?
  /**
   * Wrong guesses. Past the cap the code is dead, so a 6-digit code cannot be walked.
   */
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/**
 * Failed sign-in guesses, keyed by the IDENTIFIER typed at the login form —
 * never by userId. Login already answers an unknown identifier and a wrong
 * password with the same message so the form cannot be used to enumerate
 * accounts; keying lockout by identifier instead of by user keeps that
 * guarantee, since a made-up email locks out exactly the same way a real one
 * does.
 */
model LoginAttempt {
  id          String    @id @default(cuid())
  identifier  String    @unique
  attempts    Int       @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}

model Session {
  id                  String    @id @default(cuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash           String    @unique
  activeSchoolId      String? // which tenant this session is currently operating in
  expiresAt           DateTime
  ip                  String?
  userAgent           String?
  /// When this session passed the second factor. Only the platform console looks at it.
  mfaVerifiedAt       DateTime?
  /// When this session presented the platform admin's enrolment code. Per SESSION, not per user:
  /// the password alone, from any other session, must not reach the setup that follows.
  enrolmentVerifiedAt DateTime?
  createdAt           DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// Non-negotiable for grades and money. Every mutation to Score, SubjectResult,
// TermResult, Invoice, Payment and Discount writes here.
model AuditLog {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  actorUserId String?
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String // "score.update", "payment.reverse"
  entity      String // "Score"
  entityId    String
  before      Json?
  after       Json?
  ip          String?
  createdAt   DateTime @default(now())

  @@index([schoolId, entity, entityId])
  @@index([schoolId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// ACADEMIC STRUCTURE
// ─────────────────────────────────────────────────────────────────────────────

enum Stage {
  CRECHE
  NURSERY
  KINDERGARTEN
  PRIMARY
  JHS
  SHS
}

enum TermName {
  FIRST
  SECOND
  THIRD
}

model AcademicYear {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String // "2026/2027"
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  terms               Term[]
  enrollments         Enrollment[]
  feeStructures       FeeStructure[]
  teachingAssignments TeachingAssignment[]
  studentDiscounts    StudentDiscount[]
  mockExams           MockExam[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model Term {
  id             String       @id @default(cuid())
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  name           TermName
  sequence       Int // 1..3
  startDate      DateTime
  endDate        DateTime
  vacationDate   DateTime? // printed on the report card
  nextTermBegins DateTime? // printed on the report card
  isCurrent      Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assessments    Assessment[]
  subjectResults SubjectResult[]
  termResults    TermResult[]
  invoices       Invoice[]
  feeStructures  FeeStructure[]
  expenses       Expense[]

  attendanceDays AttendanceDay[]
  budgets        Budget[]

  @@unique([academicYearId, sequence])
  @@index([schoolId])
}

// A rung on the ladder: "Basic 5", "JHS 2", "SHS 1".
model Level {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name     String
  code     String
  stage    Stage
  order    Int // ordering across the whole ladder, KG1 = 1 … SHS3 = n

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classGroups   ClassGroup[]
  levelSubjects LevelSubject[]
  feeStructures FeeStructure[]
  mockExams     MockExam[]

  @@unique([schoolId, code])
  @@index([schoolId])
}

// A stream within a level: "Basic 5 Gold". Stable across years; the roster and
// form teacher change per academic year via Enrollment / TeachingAssignment.
model ClassGroup {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  levelId  String
  level    Level  @relation(fields: [levelId], references: [id], onDelete: Cascade)

  name     String // "Gold" or "Basic 5 Gold"
  capacity Int?

  formTeacherId String?
  formTeacher   Staff?  @relation("ClassFormTeacher", fields: [formTeacherId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments         Enrollment[]
  students            Student[]            @relation("StudentCurrentClass")
  assessments         Assessment[]
  subjectResults      SubjectResult[]
  termResults         TermResult[]
  teachingAssignments TeachingAssignment[]

  attendanceDays AttendanceDay[]

  @@unique([schoolId, levelId, name])
  @@index([schoolId])
}

model Subject {
  id       String  @id @default(cuid())
  schoolId String
  school   School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name     String
  code     String
  isCore   Boolean @default(true)
  order    Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  levelSubjects       LevelSubject[]
  assessments         Assessment[]
  subjectResults      SubjectResult[]
  teachingAssignments TeachingAssignment[]
  mockScores          MockScore[]

  @@unique([schoolId, code])
  @@index([schoolId])
}

// Which subjects a level actually offers, and whether they count toward aggregate.
model LevelSubject {
  id        String  @id @default(cuid())
  schoolId  String
  school    School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  levelId   String
  level     Level   @relation(fields: [levelId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  isElective         Boolean @default(false)
  countsForAggregate Boolean @default(true)
  order              Int     @default(0)

  @@unique([levelId, subjectId])
  @@index([schoolId])
}

// SHS course of study: General Science, Business, Visual Arts, Home Economics…
model Programme {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name     String
  code     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  students Student[]

  @@unique([schoolId, code])
  @@index([schoolId])
}

model House {
  id       String  @id @default(cuid())
  schoolId String
  school   School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name     String
  color    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  students Student[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

// ─────────────────────────────────────────────────────────────────────────────
// PEOPLE
// ─────────────────────────────────────────────────────────────────────────────

enum Gender {
  MALE
  FEMALE
}

enum StudentStatus {
  APPLICANT
  ADMITTED
  ACTIVE
  GRADUATED
  WITHDRAWN
  TRANSFERRED
  SUSPENDED
}

enum Residency {
  DAY
  BOARDING
}

enum GuardianRelationship {
  FATHER
  MOTHER
  GRANDPARENT
  UNCLE
  AUNT
  SIBLING
  GUARDIAN
  OTHER
}

model Student {
  id          String @id @default(cuid())
  schoolId    String
  school      School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  admissionNo String

  firstName   String
  middleName  String?
  lastName    String
  gender      Gender
  dateOfBirth DateTime?
  photoUrl    String?

  nationality String? @default("Ghanaian")
  hometown    String?
  religion    String?
  language    String?

  // Health — kept minimal until the infirmary module lands, but a nurse needs
  // these on day one for emergencies.
  bloodGroup   String?
  allergies    String?
  medicalNotes String?
  specialNeeds String?

  previousSchool String?
  admissionDate  DateTime?
  status         StudentStatus @default(ACTIVE)
  residency      Residency     @default(DAY)

  houseId     String?
  house       House?     @relation(fields: [houseId], references: [id], onDelete: SetNull)
  programmeId String?
  programme   Programme? @relation(fields: [programmeId], references: [id], onDelete: SetNull)

  // Denormalised pointer to the current class, for fast rosters and filters.
  // Source of truth remains Enrollment for the active academic year.
  currentClassGroupId String?
  currentClassGroup   ClassGroup? @relation("StudentCurrentClass", fields: [currentClassGroupId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  guardians      StudentGuardian[]
  enrollments    Enrollment[]
  scores         Score[]
  subjectResults SubjectResult[]
  termResults    TermResult[]
  invoices       Invoice[]
  payments       Payment[]
  discounts      StudentDiscount[]
  messages       Message[]

  attendanceEntries AttendanceEntry[]
  mockScores        MockScore[]

  @@unique([schoolId, admissionNo])
  @@index([schoolId, status])
  @@index([schoolId, currentClassGroupId])
  @@index([schoolId, lastName, firstName])
}

model Guardian {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  firstName  String
  lastName   String
  phone      String
  altPhone   String?
  email      String?
  occupation String?
  address    String?
  gpsAddress String?
  idType     String? // Ghana Card, Voter ID
  idNumber   String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  students    StudentGuardian[]
  memberships Membership[]
  payments    Payment[]
  messages    Message[]

  @@index([schoolId])
  @@index([schoolId, phone])
}

model StudentGuardian {
  id         String   @id @default(cuid())
  schoolId   String
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardianId String
  guardian   Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  relationship       GuardianRelationship
  isPrimary          Boolean              @default(false)
  receivesBills      Boolean              @default(true) // who the invoice SMS goes to
  receivesReports    Boolean              @default(true)
  isEmergencyContact Boolean              @default(false)

  createdAt DateTime @default(now())

  @@unique([studentId, guardianId])
  @@index([schoolId])
  @@index([guardianId])
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  NATIONAL_SERVICE
  CONTRACT
  VOLUNTEER
}

enum StaffStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  RESIGNED
  RETIRED
}

model Staff {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  staffNo  String

  firstName   String
  middleName  String?
  lastName    String
  gender      Gender
  dateOfBirth DateTime?
  photoUrl    String?
  phone       String?
  email       String?
  address     String?

  designation    String? // "Mathematics Teacher", "Bursar"
  qualification  String? // "B.Ed Mathematics"
  employmentType EmploymentType @default(FULL_TIME)
  isTeaching     Boolean        @default(true)
  dateHired      DateTime?
  status         StaffStatus    @default(ACTIVE)

  ssnitNumber String?
  tin         String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  memberships         Membership[]
  formClasses         ClassGroup[]         @relation("ClassFormTeacher")
  teachingAssignments TeachingAssignment[]
  createdAssessments  Assessment[]         @relation("AssessmentCreatedBy")
  enteredScores       Score[]              @relation("ScoreEnteredBy")
  subjectResults      SubjectResult[]
  messages            Message[]

  registersTaken AttendanceDay[] @relation("RegisterTakenBy")

  @@unique([schoolId, staffNo])
  @@index([schoolId, status])
}

// Who is enrolled in which class, for which year. The source of truth for rosters.
model Enrollment {
  id             String       @id @default(cuid())
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  classGroupId   String
  // Cascade for the same reason as FeeStructureItem — Restrict would block
  // school teardown. Deleting a class that still has enrolments is prevented in
  // the server action, where a useful error message can be shown.
  classGroup     ClassGroup   @relation(fields: [classGroupId], references: [id], onDelete: Cascade)

  rollNumber Int?
  status     EnrollmentStatus @default(ACTIVE)
  enrolledOn DateTime         @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, academicYearId])
  @@index([schoolId, academicYearId, classGroupId])
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  REPEATED
  WITHDRAWN
}

// Teacher X teaches Subject Y to Class Z this year. Drives "my classes" in the
// teacher portal and gates who may enter scores for a subject.
model TeachingAssignment {
  id             String       @id @default(cuid())
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  staffId        String
  staff          Staff        @relation(fields: [staffId], references: [id], onDelete: Cascade)
  subjectId      String
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  classGroupId   String
  classGroup     ClassGroup   @relation(fields: [classGroupId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([academicYearId, staffId, subjectId, classGroupId])
  @@index([schoolId, academicYearId])
  @@index([staffId])
}

// ─────────────────────────────────────────────────────────────────────────────
// ASSESSMENT, GRADING & REPORTS
// ─────────────────────────────────────────────────────────────────────────────

model GradingScale {
  id        String  @id @default(cuid())
  schoolId  String
  school    School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String // "SHS WASSCE A1–F9", "Basic School 1–9"
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bands          GradeBand[]
  subjectResults SubjectResult[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model GradeBand {
  id             String       @id @default(cuid())
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  gradingScaleId String
  gradingScale   GradingScale @relation(fields: [gradingScaleId], references: [id], onDelete: Cascade)

  grade    String // "A1", "B2", "9"
  minScore Decimal @db.Decimal(5, 2)
  maxScore Decimal @db.Decimal(5, 2)
  points   Int // aggregate weight: A1 = 1 … F9 = 9
  remark   String // "Excellent", "Credit"
  isPass   Boolean @default(true)

  @@unique([gradingScaleId, grade])
  @@index([schoolId])
}

enum AssessmentType {
  CLASS_EXERCISE
  CLASS_TEST
  GROUP_WORK
  HOMEWORK
  PROJECT
  MIDTERM_EXAM
  END_OF_TERM_EXAM
}

enum AssessmentStatus {
  DRAFT
  OPEN // teacher entering scores
  SUBMITTED // locked, awaiting approval
  APPROVED
}

// One markable item: "Class Test 2 — Mathematics — Basic 5 Gold — Term 1".
/// The components every subject is marked out of, defined once per school.
///
/// Without this a teacher builds "Class Test 1" by hand for each subject in
/// each class each term — six components across eighteen subjects is work
/// nobody does twice, so scores end up entered inconsistently or not at all.
///
/// `maxScore` doubles as the weight. The results engine weights each item's
/// percentage by `weight`, so setting weight = maxScore makes the class score
/// exactly (sum of raw marks / sum of max marks) — marks-based, which is what
/// "set the total marks for this category" means to a teacher, with no second
/// concept to explain.
model AssessmentTemplate {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  title    String // "Class Test 1", "Group Work 2", "Project Work"
  type     AssessmentType
  maxScore Decimal        @default(100) @db.Decimal(6, 2)
  /// Exam items are scaled to examScoreWeight; everything else shares
  /// classScoreWeight. This is the only thing that distinguishes them.
  isExam   Boolean        @default(false)
  order    Int            @default(0)
  isActive Boolean        @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, title])
  @@index([schoolId])
}

model Assessment {
  id           String     @id @default(cuid())
  schoolId     String
  school       School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  termId       String
  term         Term       @relation(fields: [termId], references: [id], onDelete: Cascade)
  classGroupId String
  classGroup   ClassGroup @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  subjectId    String
  subject      Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  type     AssessmentType
  title    String
  maxScore Decimal          @default(100) @db.Decimal(6, 2)
  // Share of the CLASS score this item carries (exam items excluded).
  // Items of the same term/class/subject should sum to 100.
  weight   Decimal          @default(0) @db.Decimal(5, 2)
  dueDate  DateTime?
  status   AssessmentStatus @default(DRAFT)

  createdByStaffId String?
  createdBy        Staff?  @relation("AssessmentCreatedBy", fields: [createdByStaffId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scores Score[]

  // One "Class Test 1" per class per subject per term. Makes creating the
  // term's components from the template idempotent — a second run fills gaps
  // instead of duplicating the sheet.
  @@unique([termId, classGroupId, subjectId, title])
  @@index([schoolId, termId, classGroupId, subjectId])
}

model Score {
  id           String     @id @default(cuid())
  schoolId     String
  school       School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  rawScore Decimal? @db.Decimal(6, 2) // null = not yet marked / absent
  isAbsent Boolean  @default(false)
  remark   String?

  enteredByStaffId String?
  enteredBy        Staff?  @relation("ScoreEnteredBy", fields: [enteredByStaffId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([assessmentId, studentId])
  @@index([schoolId, studentId])
}

/**
 * A mock examination for the final-year (BECE candidate) class — "Mock 1",
 * "Mock 2" — sat by the whole year group across its streams.
 * Deliberately SEPARATE from Assessment. The results engine adds every
 * assessment in a term into the report card, and a mock must never move a
 * term's marks: it is a rehearsal for an external exam, graded and aggregated
 * the way that exam is, and read on its own broadsheet. Grades, the aggregate
 * and positions are derived on read (mock-engine.ts) rather than stored.
 */
model MockExam {
  id             String       @id @default(cuid())
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  levelId        String
  level          Level        @relation(fields: [levelId], references: [id], onDelete: Cascade)

  title       String // "Mock 1"
  sittingDate DateTime?
  // Closed = marks are final and no longer editable from the sheet.
  isClosed    Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scores MockScore[]

  @@unique([schoolId, academicYearId, levelId, title])
  @@index([schoolId])
}

/**
 * One pupil's mark in one subject of one mock, out of 100.
 */
model MockScore {
  id         String   @id @default(cuid())
  schoolId   String
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  mockExamId String
  mockExam   MockExam @relation(fields: [mockExamId], references: [id], onDelete: Cascade)
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId  String
  subject    Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  rawScore Decimal? @db.Decimal(5, 2) // null with isAbsent = absent
  isAbsent Boolean  @default(false)

  // Who typed it, for the audit trail. A plain id, not a relation: the staff
  // record may be removed and the mark must stay.
  enteredByStaffId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([mockExamId, studentId, subjectId])
  @@index([schoolId])
  @@index([mockExamId, subjectId])
}

enum ResultStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PUBLISHED
}

/// Where a result came from.
///
/// COMPUTED rows are rolled up by the results engine from marks entered in School
/// OS. RECORDS rows were transcribed from the school's own paper records for a
/// year before it used School OS — a JHS 3 class's JHS 1 and JHS 2 terms, which
/// a school adopting the system mid-way otherwise has no way to hold. The engine
/// never recomputes a RECORDS row (there are no marks behind it to recompute
/// from, and a recompute would blank it), never decides a promotion from one, and
/// publishing never reaches one, so it is never shown to parents or texted.
enum ResultSource {
  COMPUTED
  RECORDS
}

// Computed per student, per subject, per term. Written by the results engine —
// never hand-edited without an AuditLog entry.
model SubjectResult {
  id           String     @id @default(cuid())
  schoolId     String
  school       School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  termId       String
  term         Term       @relation(fields: [termId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId    String
  subject      Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  classGroupId String
  classGroup   ClassGroup @relation(fields: [classGroupId], references: [id], onDelete: Cascade)

  classScore Decimal? @db.Decimal(6, 2) // already scaled to the 30 (or 50)
  examScore  Decimal? @db.Decimal(6, 2) // already scaled to the 70 (or 50)
  totalScore Decimal? @db.Decimal(6, 2)

  gradingScaleId String?
  gradingScale   GradingScale? @relation(fields: [gradingScaleId], references: [id], onDelete: SetNull)
  grade          String?
  points         Int?
  remark         String?

  subjectPosition Int?
  subjectSize     Int?

  teacherId String?
  teacher   Staff?  @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  source ResultSource @default(COMPUTED)

  computedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([termId, studentId, subjectId])
  @@index([schoolId, termId, classGroupId])
}

enum PromotionStatus {
  PENDING
  PROMOTED
  REPEATED
  GRADUATED
}

// The report card header: one row per student per term.
model TermResult {
  id           String     @id @default(cuid())
  schoolId     String
  school       School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  termId       String
  term         Term       @relation(fields: [termId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classGroupId String
  classGroup   ClassGroup @relation(fields: [classGroupId], references: [id], onDelete: Cascade)

  subjectsCount Int?
  totalMarks    Decimal? @db.Decimal(8, 2)
  average       Decimal? @db.Decimal(5, 2)
  aggregate     Int? // best-N points, BECE style
  classPosition Int?
  classSize     Int?

  /// What the term was marked OUT OF, frozen at compute time.
  ///
  /// Every subject is worth 100 (class weight + exam weight make 100), so an
  /// upper-primary class offering 9 subjects is marked out of 900. Stored
  /// rather than derived because a level's subject list is edited — a card
  /// reprinted after a subject is added must still read the 900 it was marked
  /// against, not a 1000 nobody sat.
  subjectsOffered Int?
  possibleMarks   Int?
  /// totalMarks as a percentage of possibleMarks. The end-of-year promotion
  /// rule sums this pair across the three terms; see `applyYearPromotion`.
  percentage      Decimal? @db.Decimal(5, 2)

  // Attendance is summarised here so the report card can print it before the
  // attendance module exists; the module will later populate it automatically.
  daysPresent Int?
  daysTotal   Int?

  conduct           String?
  attitude          String?
  interest          String?
  formTeacherRemark String?
  headRemark        String?

  promotionStatus PromotionStatus @default(PENDING)
  status          ResultStatus    @default(DRAFT)
  source          ResultSource    @default(COMPUTED)
  publishedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([termId, studentId])
  @@index([schoolId, termId, classGroupId])
  @@index([schoolId, status])
}

// ─────────────────────────────────────────────────────────────────────────────
// ATTENDANCE
// ─────────────────────────────────────────────────────────────────────────────

enum AttendanceMark {
  PRESENT
  LATE // in school, late — counts present, but the office can see it
  EXCUSED // away with a reason the school accepts — counts absent, with a note
  ABSENT
}

/// One row per class per DAY: the register was taken.
///
/// Separate from the marks on purpose, because the report card's denominator is
/// "days the register was taken", and that has to be a fact the database holds
/// rather than something inferred from how many children happen to have marks.
/// A day nobody marked produces no row, and therefore costs nobody an absence —
/// the same principle as a subject nobody assessed not inventing a score.
model AttendanceDay {
  id           String     @id @default(cuid())
  schoolId     String
  school       School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  termId       String
  term         Term       @relation(fields: [termId], references: [id], onDelete: Cascade)
  classGroupId String
  classGroup   ClassGroup @relation(fields: [classGroupId], references: [id], onDelete: Cascade)

  /// The school day itself. A date, not a timestamp: a register belongs to a
  /// day, and storing 00:00 in one timezone is how a Monday becomes a Sunday.
  date DateTime @db.Date

  takenByStaffId String?
  takenBy        Staff?  @relation("RegisterTakenBy", fields: [takenByStaffId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries AttendanceEntry[]

  @@unique([classGroupId, date])
  @@index([schoolId, termId, classGroupId])
}

/// What one child was marked on one day.
model AttendanceEntry {
  id              String        @id @default(cuid())
  schoolId        String
  school          School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  attendanceDayId String
  attendanceDay   AttendanceDay @relation(fields: [attendanceDayId], references: [id], onDelete: Cascade)
  studentId       String
  student         Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  mark AttendanceMark
  /// Why, for an excused absence. Printed nowhere; read by the office.
  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([attendanceDayId, studentId])
  @@index([schoolId, studentId])
}

// ─────────────────────────────────────────────────────────────────────────────
// CHART OF ACCOUNTS
//
// A real chart of accounts — codes classified Asset/Liability/Equity/Income/
// Expense — for the accountant who wants proper books, not just a cash book.
// FeeCategory/ExpenseCategory optionally point at one, and SchoolSettings
// names the school's core accounts (cash, bank, momo, receivable, payable).
//
// Foundation only: nothing posts to these accounts yet. That is deliberate —
// the posting engine is grafted onto already-live invoice/payment/expense
// code in a later, isolated change, once these accounts exist to post to.
// ─────────────────────────────────────────────────────────────────────────────

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

model LedgerAccount {
  id       String          @id @default(cuid())
  schoolId String
  school   School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  code     String
  name     String
  type     AccountType
  // Optional grouping (e.g. every fee-item income account under "Fees
  // Income"). SetNull, not Cascade: a parent's removal must not orphan-delete
  // its children, only ungroup them.
  parentId String?
  parent   LedgerAccount?  @relation("LedgerAccountParent", fields: [parentId], references: [id], onDelete: SetNull)
  children LedgerAccount[] @relation("LedgerAccountParent")
  isActive Boolean         @default(true)
  order    Int             @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  feeCategoriesAsIncome      FeeCategory[]     @relation("FeeCategoryIncomeAccount")
  expenseCategoriesAsExpense ExpenseCategory[] @relation("ExpenseCategoryExpenseAccount")
  journalLines               JournalLine[]

  @@unique([schoolId, code])
  @@index([schoolId, type])
}

/**
 * Which live event a journal entry records — so a reversal can find the
 * original by (sourceType, sourceId) without a separate pointer column on
 * every source table.
 */
enum JournalSourceType {
  INVOICE
  PAYMENT
  EXPENSE
  VENDOR_BILL
  VENDOR_PAYMENT
}

/**
 * The posting engine's own record, entirely separate from what it posts
 * about. Nothing here is read by `recalcInvoice`, `recalcVendorBill` or any
 * invoice/payment/expense total — those stay the source of truth they always
 * were, and this is a PARALLEL record for the accountant, not a dependency of
 * the money already working. See ledger-engine.ts for the one rule this
 * implies: posting is additive and best-effort, and a missing account mapping
 * skips a posting, never blocks the invoice/payment/expense it is about.
 */
model JournalEntry {
  id         String            @id @default(cuid())
  schoolId   String
  school     School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  entryNo    String
  date       DateTime          @default(now())
  memo       String
  sourceType JournalSourceType
  sourceId   String

  postedByUserId String?
  postedBy       User?   @relation("JournalEntryPostedBy", fields: [postedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  lines JournalLine[]

  @@unique([schoolId, entryNo])
  @@index([schoolId, sourceType, sourceId])
}

model JournalLine {
  id             String        @id @default(cuid())
  schoolId       String
  school         School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  journalEntryId String
  journalEntry   JournalEntry  @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  // Restrict, not SetNull: a line with no account is not a line, it is a
  // silent hole in a set of numbers that has to sum to zero. An account with
  // postings against it must stay in the chart, exactly like a billed
  // FeeCategory must stay biller-side — see deleteLedgerAccount's refusal.
  accountId      String
  account        LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  debit          Decimal       @default(0) @db.Decimal(12, 2)
  credit         Decimal       @default(0) @db.Decimal(12, 2)
  description    String?

  createdAt DateTime @default(now())

  @@index([schoolId])
  @@index([accountId])
}

// ─────────────────────────────────────────────────────────────────────────────
// FEES & PAYMENTS
// ─────────────────────────────────────────────────────────────────────────────

model FeeCategory {
  id          String  @id @default(cuid())
  schoolId    String
  school      School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name        String // Tuition, PTA Levy, Examination, Feeding, ICT, Boarding
  code        String
  description String?
  isMandatory Boolean @default(true)
  order       Int     @default(0)

  // Which income account this fee line posts to, once posting exists.
  // Optional + SetNull: a school that has not set up its chart of accounts
  // yet must still be able to bill fees, and deleting an account must never
  // delete spend history — same rule as every other category FK here.
  incomeAccountId String?
  incomeAccount   LedgerAccount? @relation("FeeCategoryIncomeAccount", fields: [incomeAccountId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  structureItems FeeStructureItem[]
  invoiceItems   InvoiceItem[]

  @@unique([schoolId, code])
  @@index([schoolId])
}

enum FeeApplicability {
  ANY
  DAY
  BOARDING
}

enum StudentTypeApplicability {
  ANY
  NEW
  CONTINUING
}

// The price list: "SHS 1, Boarding, Term 1, new student".
model FeeStructure {
  id             String       @id @default(cuid())
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  termId         String?
  term           Term?        @relation(fields: [termId], references: [id], onDelete: Cascade) // null = applies to all terms
  levelId        String
  level          Level        @relation(fields: [levelId], references: [id], onDelete: Cascade)

  name        String
  residency   FeeApplicability         @default(ANY)
  studentType StudentTypeApplicability @default(ANY)
  isActive    Boolean                  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items FeeStructureItem[]

  @@index([schoolId, academicYearId, levelId])
}

model FeeStructureItem {
  id             String       @id @default(cuid())
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  feeStructureId String
  feeStructure   FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  feeCategoryId  String
  // Cascade, not Restrict: a fee-structure line without its category is
  // meaningless, and Restrict here blocks tearing down a whole school (the
  // School→FeeCategory cascade trips over it). Guarding against deleting an
  // in-use category belongs in the server action, not the FK.
  feeCategory    FeeCategory  @relation(fields: [feeCategoryId], references: [id], onDelete: Cascade)
  amount         Decimal      @db.Decimal(12, 2)

  @@unique([feeStructureId, feeCategoryId])
  @@index([schoolId])
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

/**
 * What KIND of bill this is — Term Fees, PTA Levy, a Trip — as distinct from
 * the FeeCategory lines an invoice is made of. A fee category is one row on a
 * bill; a bill code is the bill itself, which is what an accountant reaches
 * for when asked "how much did the Trip Bill raise this year" across every
 * fee category it happened to include.
 */
model BillCode {
  id          String  @id @default(cuid())
  schoolId    String
  school      School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name        String // Term Fees Bill, PTA Bill, Trip/Excursion Bill, Uniform Bill
  code        String
  description String?
  order       Int     @default(0)
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices Invoice[]

  @@unique([schoolId, code])
  @@index([schoolId])
}

model Invoice {
  id         String    @id @default(cuid())
  schoolId   String
  school     School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId  String
  student    Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  termId     String
  term       Term      @relation(fields: [termId], references: [id], onDelete: Cascade)
  // Which BILL this is, not which fee lines it carries. Nullable and SetNull,
  // matching FeeCategory/ExpenseCategory: a deleted bill code must never take
  // a real invoice's history with it.
  billCodeId String?
  billCode   BillCode? @relation(fields: [billCodeId], references: [id], onDelete: SetNull)

  invoiceNo String
  issueDate DateTime  @default(now())
  dueDate   DateTime?

  subtotal       Decimal @default(0) @db.Decimal(12, 2)
  discountTotal  Decimal @default(0) @db.Decimal(12, 2)
  // Arrears carried in from the previous term, so the parent sees one number.
  broughtForward Decimal @default(0) @db.Decimal(12, 2)
  total          Decimal @default(0) @db.Decimal(12, 2)
  amountPaid     Decimal @default(0) @db.Decimal(12, 2)
  balance        Decimal @default(0) @db.Decimal(12, 2)

  status InvoiceStatus @default(DRAFT)
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items       InvoiceItem[]
  allocations PaymentAllocation[]
  paymentPlan PaymentPlan?

  @@unique([schoolId, invoiceNo])
  @@unique([studentId, termId])
  @@index([schoolId, status])
  @@index([schoolId, termId])
}

model InvoiceItem {
  id            String       @id @default(cuid())
  schoolId      String
  school        School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  invoiceId     String
  invoice       Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  feeCategoryId String?
  feeCategory   FeeCategory? @relation(fields: [feeCategoryId], references: [id], onDelete: SetNull)

  description String
  amount      Decimal @db.Decimal(12, 2)
  discount    Decimal @default(0) @db.Decimal(12, 2)

  @@index([schoolId])
  @@index([invoiceId])
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum DiscountReason {
  STAFF_CHILD
  SIBLING
  BURSARY
  SCHOLARSHIP
  HARDSHIP
  OTHER
}

model Discount {
  id                  String         @id @default(cuid())
  schoolId            String
  school              School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name                String
  type                DiscountType
  value               Decimal        @db.Decimal(12, 2)
  reason              DiscountReason @default(OTHER)
  // Restrict to one fee category (e.g. tuition only) or leave null for all.
  appliesToCategoryId String?
  isActive            Boolean        @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  students StudentDiscount[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model StudentDiscount {
  id             String       @id @default(cuid())
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  discountId     String
  discount       Discount     @relation(fields: [discountId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  approvedByUserId String?
  approvedBy       User?     @relation("DiscountApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  approvedAt       DateTime?
  note             String?

  createdAt DateTime @default(now())

  @@unique([studentId, discountId, academicYearId])
  @@index([schoolId])
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  BANK_DEPOSIT
  MOBILE_MONEY
  CARD
  CHEQUE
}

enum MomoNetwork {
  MTN
  TELECEL
  AIRTELTIGO
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  REVERSED
  FAILED
}

model Payment {
  id         String    @id @default(cuid())
  schoolId   String
  school     School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId  String
  student    Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  // Who handed over the money — useful when a parent pays for several children.
  guardianId String?
  guardian   Guardian? @relation(fields: [guardianId], references: [id], onDelete: SetNull)

  receiptNo   String
  amount      Decimal       @db.Decimal(12, 2)
  method      PaymentMethod
  momoNetwork MomoNetwork?
  reference   String? // momo transaction id, bank slip no, cheque no
  bankSlipUrl String?

  // Reserved for a future Paystack integration. Every MVP payment is recorded
  // by the bursar, so these stay null until online parent payment ships —
  // present now purely to avoid a migration then.
  providerRef    String?
  providerStatus String?

  status PaymentStatus @default(CONFIRMED)
  paidAt DateTime      @default(now())
  note   String?

  recordedByUserId String?
  recordedBy       User?   @relation("PaymentRecordedBy", fields: [recordedByUserId], references: [id], onDelete: SetNull)

  reversedAt     DateTime?
  reversalReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  allocations   PaymentAllocation[]
  statementLine StatementLine?

  @@unique([schoolId, receiptNo])
  @@index([schoolId, paidAt])
  @@index([schoolId, studentId])
}

// A payment can settle several invoices (this term plus arrears).
model PaymentAllocation {
  id        String  @id @default(cuid())
  schoolId  String
  school    School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount    Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@unique([paymentId, invoiceId])
  @@index([schoolId])
  @@index([invoiceId])
}

// ─────────────────────────────────────────────────────────────────────────────
// EXPENDITURE
//
// A bursar's running cash book — "what came in, what went out, what's left"
// per term — that ALSO posts to a real chart of accounts once one is set up
// (see the CHART OF ACCOUNTS section and ledger-engine.ts). The cash book is
// never a dependency of the ledger or the other way round: Expense.balance
// answers the bursar's question whether or not the accounts are mapped, and
// a JournalEntry is a parallel record for the accountant, not a second
// source of truth. Payroll and requisitions are still deliberately out of
// scope for now.
// ─────────────────────────────────────────────────────────────────────────────

model ExpenseCategory {
  id          String  @id @default(cuid())
  schoolId    String
  school      School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name        String // Salaries, Utilities, Repairs, Feeding, Transport, Stationery
  code        String
  description String?
  order       Int     @default(0)
  isActive    Boolean @default(true)

  // Which expense account this heading posts to, once posting exists. See
  // FeeCategory.incomeAccountId for why this is optional and SetNull.
  expenseAccountId String?
  expenseAccount   LedgerAccount? @relation("ExpenseCategoryExpenseAccount", fields: [expenseAccountId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses    Expense[]
  budgets     Budget[]
  vendorBills VendorBill[]

  @@unique([schoolId, code])
  @@index([schoolId])
}

enum ExpenseStatus {
  DRAFT
  APPROVED
  PAID
  CANCELLED
}

model Expense {
  id         String           @id @default(cuid())
  schoolId   String
  school     School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  // Optional + SetNull rather than Restrict, matching InvoiceItem: deleting a
  // category must never delete spend history, and Restrict would block school
  // teardown. An uncategorised expense is recoverable; a vanished one is not.
  categoryId String?
  category   ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  // Which term the spend belongs to, so income vs expenditure lines up per term.
  termId     String?
  term       Term?            @relation(fields: [termId], references: [id], onDelete: SetNull)

  voucherNo   String
  description String
  amount      Decimal       @db.Decimal(12, 2)
  payee       String? // vendor or staff name
  method      PaymentMethod @default(CASH)
  momoNetwork MomoNetwork?
  reference   String? // momo id, cheque no, bank ref
  receiptUrl  String? // photo of the receipt — how bursars actually file these

  status  ExpenseStatus @default(PAID)
  spentAt DateTime      @default(now())
  note    String?

  recordedByUserId String?
  recordedBy       User?     @relation("ExpenseRecordedBy", fields: [recordedByUserId], references: [id], onDelete: SetNull)
  approvedByUserId String?
  approvedBy       User?     @relation("ExpenseApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  approvedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, voucherNo])
  @@index([schoolId, spentAt])
  @@index([schoolId, categoryId])
  @@index([schoolId, termId])
}

// ─────────────────────────────────────────────────────────────────────────────
// CREDITORS — ACCOUNTS PAYABLE
//
// What the school owes a VENDOR, as distinct from an ordinary Expense (a
// vendor bill is owed before it is paid, and can be paid in instalments; an
// Expense is a single cash-book line recorded once, usually already paid).
// Mirrors Invoice/Payment/PaymentAllocation's shape deliberately: a bill has
// a balance recalculated from its allocations, a payment can be FIFO-spread
// across a vendor's oldest unpaid bills, same as a parent's payment against a
// student's invoices.
// ─────────────────────────────────────────────────────────────────────────────

model Vendor {
  id            String  @id @default(cuid())
  schoolId      String
  school        School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name          String
  contactPerson String?
  phone         String?
  note          String?
  isActive      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bills    VendorBill[]
  payments VendorPayment[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

enum VendorBillStatus {
  DRAFT
  APPROVED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

model VendorBill {
  id         String           @id @default(cuid())
  schoolId   String
  school     School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  vendorId   String
  vendor     Vendor           @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  // Optional + SetNull, matching Expense.categoryId: deleting an expense
  // heading must never delete spend history.
  categoryId String?
  category   ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  billNo      String
  description String
  billDate    DateTime  @default(now())
  dueDate     DateTime?

  amount     Decimal @default(0) @db.Decimal(12, 2)
  amountPaid Decimal @default(0) @db.Decimal(12, 2)
  balance    Decimal @default(0) @db.Decimal(12, 2)

  status VendorBillStatus @default(DRAFT)
  note   String?

  recordedByUserId String?
  recordedBy       User?     @relation("VendorBillRecordedBy", fields: [recordedByUserId], references: [id], onDelete: SetNull)
  approvedByUserId String?
  approvedBy       User?     @relation("VendorBillApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  approvedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  allocations VendorPaymentAllocation[]

  @@unique([schoolId, billNo])
  @@index([schoolId, status])
  @@index([schoolId, vendorId])
  @@index([schoolId, categoryId])
}

model VendorPayment {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  paymentNo   String
  amount      Decimal       @db.Decimal(12, 2)
  method      PaymentMethod
  momoNetwork MomoNetwork?
  reference   String?
  paidAt      DateTime      @default(now())
  note        String?

  recordedByUserId String?
  recordedBy       User?   @relation("VendorPaymentRecordedBy", fields: [recordedByUserId], references: [id], onDelete: SetNull)

  reversedAt     DateTime?
  reversalReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  allocations VendorPaymentAllocation[]

  @@unique([schoolId, paymentNo])
  @@index([schoolId, paidAt])
  @@index([schoolId, vendorId])
}

// A vendor payment can settle several bills (FIFO), same as PaymentAllocation.
model VendorPaymentAllocation {
  id              String        @id @default(cuid())
  schoolId        String
  school          School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  vendorPaymentId String
  vendorPayment   VendorPayment @relation(fields: [vendorPaymentId], references: [id], onDelete: Cascade)
  vendorBillId    String
  vendorBill      VendorBill    @relation(fields: [vendorBillId], references: [id], onDelete: Cascade)
  amount          Decimal       @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@unique([vendorPaymentId, vendorBillId])
  @@index([schoolId])
  @@index([vendorBillId])
}

// ─────────────────────────────────────────────────────────────────────────────
// MESSAGING (SMS / EMAIL)
// ─────────────────────────────────────────────────────────────────────────────

enum MessageChannel {
  SMS
  EMAIL
}

enum SmsProvider {
  ARKESEL
  HUBTEL
  MNOTIFY
}

enum AudienceType {
  ALL_PARENTS
  ALL_STAFF
  CLASS
  LEVEL
  DEBTORS
  CUSTOM
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  FAILED
}

enum DeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
}

model MessageTemplate {
  id       String         @id @default(cuid())
  schoolId String
  school   School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name     String
  channel  MessageChannel @default(SMS)
  subject  String?
  body     String // supports {{student_name}}, {{balance}}, {{term}} merge fields
  isSystem Boolean        @default(false) // seeded triggers: payment received, results out

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaigns MessageCampaign[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model MessageCampaign {
  id       String         @id @default(cuid())
  schoolId String
  school   School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name     String
  channel  MessageChannel @default(SMS)

  templateId String?
  template   MessageTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  subject    String?
  body       String

  audienceType   AudienceType
  audienceFilter Json? // { classGroupIds: [...], minBalance: 100 }

  status      CampaignStatus @default(DRAFT)
  scheduledAt DateTime?
  sentAt      DateTime?

  totalRecipients Int      @default(0)
  sentCount       Int      @default(0)
  failedCount     Int      @default(0)
  estimatedCost   Decimal? @db.Decimal(10, 2)

  createdByUserId String?
  createdBy       User?   @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]

  @@index([schoolId, status])
}

// One row per delivery attempt — campaign blasts and transactional triggers alike.
model Message {
  id         String           @id @default(cuid())
  schoolId   String
  school     School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campaignId String?
  campaign   MessageCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  channel MessageChannel @default(SMS)
  toPhone String?
  toEmail String?
  body    String

  studentId  String?
  student    Student?  @relation(fields: [studentId], references: [id], onDelete: SetNull)
  guardianId String?
  guardian   Guardian? @relation(fields: [guardianId], references: [id], onDelete: SetNull)
  staffId    String?
  staff      Staff?    @relation(fields: [staffId], references: [id], onDelete: SetNull)

  provider    SmsProvider?
  providerRef String?
  status      DeliveryStatus @default(QUEUED)
  segments    Int?
  cost        Decimal?       @db.Decimal(10, 4)
  error       String?

  sentAt      DateTime?
  deliveredAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([schoolId, status])
  @@index([schoolId, createdAt])
  @@index([campaignId])
}
