# ── Database (Supabase Postgres) ─────────────────────────────────────────────
# Project Settings → Database → Connection string
#
# DATABASE_URL  = Transaction pooler (port 6543). Used by the app at runtime.
#                 MUST carry ?pgbouncer=true&connection_limit=1
# DIRECT_URL    = Direct connection (port 5432). Used ONLY by prisma migrate.
#                 Omitting this makes migrations hang or fail with
#                 prepared-statement errors — the #1 Supabase + Prisma bug.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Row-Level Security enforcement. Ships dormant; flip to "on" after the RLS
# policies are applied and verified.
# The running app connects as a restricted role (no BYPASSRLS, owns nothing) so
# the row-level security policies actually bind to it. Create it with
# `npm run db:rls`, which prints the password once. Leave this unset and the app
# falls back to DATABASE_URL — which bypasses RLS, i.e. no tenant isolation.
# ⚠️ NOT connection_limit=1: with RLS on, every model operation becomes a
# transaction, and one connection cannot serve them (P2024). 4 is sized for a
# free-tier nano instance — see the note in CLAUDE.md before raising it.
APP_DATABASE_URL="postgresql://school_os_app.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=4"

# "on" makes the app set the tenant GUCs the policies read. Pointless without
# APP_DATABASE_URL, because the owner role bypasses row security regardless.
DB_RLS="on"

# ── App ──────────────────────────────────────────────────────────────────────
APP_URL="http://localhost:3000"

# ── SMS (Ghana) ──────────────────────────────────────────────────────────────
# With either of the first two empty, EVERY text is a dry run: recorded, costed
# and shown in Messages, but nothing leaves the building. That is deliberate —
# a half-configured gateway silently texting real parents is much worse.
#
# One of: ARKESEL | HUBTEL | MNOTIFY
SMS_PROVIDER=""
# ARKESEL / MNOTIFY: the API key as issued.
# HUBTEL: the credential is a PAIR — paste it as "clientid:clientsecret" and it
# is base64-encoded for you (an already-encoded value is accepted too).
SMS_API_KEY=""
# Max 11 characters, and it must be REGISTERED with the provider — an
# unregistered sender is the usual reason a text is accepted and never arrives.
SMS_SENDER_ID=""
# Set to 1 to force dry-run even with a key — staging, or a verify run that must
# not text anyone or call the gateway.
SMS_DRY_RUN=""

# Two-factor sign-in for the platform admin. 32 random bytes, base64: `openssl rand -base64 32`.
# Encrypts each admin's authenticator secret before it is stored. Keep it with the other
# deployment secrets (and back it up): lose it and every stored secret is unreadable —
# `node scripts/reset-platform-2fa.mjs <email>` then clears them so admins can enrol again.
TOTP_ENCRYPTION_KEY=""

# Shared secret for the scheduled job that releases held SMS campaigns (POST /api/cron/messages, called every
# five minutes by .github/workflows/release-scheduled-messages.yml). The endpoint refuses everything (503) until
# this is set. Generate with `openssl rand -base64 32`; set the SAME value as the CRON_SECRET repository secret.
CRON_SECRET=""
